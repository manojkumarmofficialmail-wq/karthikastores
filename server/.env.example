# ---------------------------------------------------------------------------
# Karthika Stores — API configuration
# Copy to server/.env and fill in. `npm run dev` loads it automatically.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Number of reverse proxies in front of the API. Rate limiting buckets on the
# client IP, so only count hops that really exist — trusting a phantom proxy
# lets a client forge X-Forwarded-For. Render/Fly/Nginx: 1. Direct: 0.
TRUST_PROXY=0

# Origins allowed to call the API with credentials (comma separated).
# Leave unset in development — the default covers localhost and 127.0.0.1 on
# Vite's dev (5173) and preview (4173) ports.
# CORS_ORIGINS=https://shop.karthikastores.in

# --- Neon PostgreSQL -------------------------------------------------------
# Neon console -> your project -> Connection string -> "Pooled connection".
# Keep ?sslmode=require — Neon refuses plaintext connections.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/karthika?sslmode=require
# Set to false only when pointing at a local Postgres without TLS.
# DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=10
# Required when the API and the web app are on different sites in production.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# --- Payments --------------------------------------------------------------
# UPI QR needs nothing here: the shop's UPI ID lives in the database and is
# edited from Store -> Settings -> UPI in the dashboard. Seed it once with
# SEED_UPI_VPA below, or just type it into the dashboard after seeding.
#
# PAYMENT_PROVIDER only governs *card and netbanking*:
# none      : DEFAULT. No gateway. Customers pay by UPI QR, or the rider or
#             the counter. Everything else in the shop works normally — leave
#             it here until you are ready to take cards.
# simulated : local dev gateway (real signature + webhook verification,
#             local counterparty). Refused when NODE_ENV=production.
# razorpay  : real Razorpay API. Test keys work — dashboard.razorpay.com.
PAYMENT_PROVIDER=none

# Only needed when PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook -> Settings -> Webhooks in the Razorpay dashboard.
# URL: https://your-api-host/api/payments/webhook   Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Seed shop -------------------------------------------------------------
# Only used the first time db/seed.js runs; re-seeding never overwrites a UPI
# ID typed into the dashboard. REPLACE THIS with the shop's real UPI ID before
# taking live orders — whatever it resolves to is where the money goes.
SEED_UPI_VPA=karthikastores@okicici
SEED_UPI_PAYEE=Karthika Stores

# --- Seed accounts ---------------------------------------------------------
SEED_ADMIN_PHONE=9876500001
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_PHONE=9876500002
SEED_CUSTOMER_PASSWORD=Customer@123
